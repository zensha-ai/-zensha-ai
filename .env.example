# ─── Site ────────────────────────────────────────────────────────────────
# Public URL (no trailing slash). Set only once a domain has been cleared and is owned.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep "false" until launch — robots.txt blocks all crawling otherwise.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ─── Verified contact details (leave blank until confirmed) ──────────────
NEXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp number in international format, digits only, e.g. 9198XXXXXXXX
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_LOCATION=
NEXT_PUBLIC_CONTACT_HOURS=

# ─── Founder publication approvals (see content doc "Publishing checks") ─
# Employer names (Merchmix | Alkye, Uber Ext, Flipkart) on the About page
NEXT_PUBLIC_PUBLISH_FOUNDER_EMPLOYMENT=false
# The three personal portfolio projects on Our Work
NEXT_PUBLIC_PUBLISH_FOUNDER_PORTFOLIO=false

# ─── Supabase ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — never prefix with NEXT_PUBLIC_. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Random string used to hash IP addresses for rate limiting (e.g. `openssl rand -hex 32`)
IP_HASH_SALT=

# ─── Razorpay (only after merchant onboarding is complete) ───────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Payments remain disabled (honest "not enabled yet" message) until this is "true"
PAYMENTS_ENABLED=false
